DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ใช้โดเมนหลักแบบไม่มี www เพียงรูปแบบเดียว
RewriteCond %{HTTP_HOST} ^www\.sunnext\.co\.th$ [NC]
RewriteRule ^ https://sunnext.co.th%{REQUEST_URI} [R=301,L]

# รวม URL ที่ลงท้ายด้วย /index.html ให้เหลือ URL หลักแบบ / เพียงรูปแบบเดียว
# ตรวจ THE_REQUEST เพื่อไม่ให้กระทบการเปิด index.html ภายในของ Apache
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
</IfModule>
